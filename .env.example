# Copy to .env for local overrides. Never commit real secrets.

AEGIS_SERVER_PORT=8080

AEGIS_DATASOURCE_URL=jdbc:postgresql://localhost:5432/aegis
AEGIS_DATASOURCE_USERNAME=aegis
AEGIS_DATASOURCE_PASSWORD=change-me

POSTGRES_DB=aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

AEGIS_HEALTH_SHOW_DETAILS=always
