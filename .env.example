# Copy to .env for local overrides. Never commit real secrets.

AEGIS_SERVER_PORT=8080

AEGIS_DATASOURCE_URL=jdbc:postgresql://localhost:5432/aegis
AEGIS_DATASOURCE_USERNAME=aegis
AEGIS_DATASOURCE_PASSWORD=change-me

POSTGRES_DB=aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

AEGIS_HEALTH_SHOW_DETAILS=always

AEGIS_REDIS_HOST=localhost
AEGIS_REDIS_PORT=6379
AEGIS_REDIS_PASSWORD=
AEGIS_REDIS_SSL=false
AEGIS_REDIS_KEY_PREFIX=aegis:
REDIS_PORT=6379

# Idempotency coordination is backed by Redis.
AEGIS_IDEMPOTENCY_ENABLED=true
AEGIS_IDEMPOTENCY_PROCESSING_TTL_SECONDS=60
AEGIS_IDEMPOTENCY_WAIT_TIMEOUT_MS=30000
AEGIS_IDEMPOTENCY_POLL_INTERVAL_MS=25
AEGIS_IDEMPOTENCY_COMPLETED_TTL_SECONDS=86400

# Kafka proxy-completion events are opt-in; provide a reachable broker when enabling them.
AEGIS_KAFKA_ENABLED=false
AEGIS_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
AEGIS_KAFKA_PROXY_EVENTS_TOPIC=aegis.proxy-events.v1

# Generate a new value with: openssl rand -base64 32
AEGIS_JWT_SECRET=replace-with-a-base64-encoded-random-32-byte-secret
AEGIS_JWT_TOKEN_TTL=PT15M
AEGIS_BOOTSTRAP_ADMIN_USERNAME=admin
AEGIS_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-local-password
