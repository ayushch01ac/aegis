# =========================================================================
# Spring Boot 21 / Java 21 - Standard .gitignore
# =========================================================================

# Compiled Java class files
*.class

# Log files
*.log
logs/

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files (Uncomment if you do not want to commit built jars/wars)
# *.jar
# *.war
# *.nar
# *.ear
# *.zip
# *.tar.gz
# *.rar

# Virtual machine crash logs
hs_err_pid*
replay_pid*

# =========================================================================
# Build Tools (Maven & Gradle)
# =========================================================================

# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/.search
.flattened-pom.xml

# Ensure Maven Wrapper JAR is NOT ignored
!/.mvn/wrapper/maven-wrapper.jar

# Gradle
.gradle/
build/
.gradletasknamecache
gradle-app.setting

# Ensure Gradle Wrapper JAR is NOT ignored
!/gradle/wrapper/gradle-wrapper.jar

# =========================================================================
# IDEs & Editors
# =========================================================================

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/
.idea_modules/

# Eclipse / Spring Tool Suite (STS)
.metadata/
bin/
tmp/
.settings/
.project
.classpath
*.launch
.factorypath
.apt_generated
.sts4-cache
.springBeans

# Visual Studio Code (VS Code)
.vscode/
.code-workspace
.history/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# =========================================================================
# Environment & Sensitive Information (Security)
# =========================================================================
# Block local credentials, secrets, and environment configurations
.env
.env.local
.env.*.local
*.properties.local
*.yml.local
*.yaml.local

# Help documentation generated by Spring Initializr
HELP.md

# =========================================================================
# Operating System Files
# =========================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
